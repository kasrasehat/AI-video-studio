{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "full-ai-video-system/checkpoint",
  "title": "Stage Checkpoint",
  "description": "Persistent state record for one pipeline stage of one production.",
  "type": "object",
  "required": ["version", "project_id", "stage", "status", "timestamp"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "project_id": { "type": "string", "minLength": 1 },
    "stage": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["in_progress", "awaiting_human", "completed", "failed", "skipped"] },
    "timestamp": { "type": "string" },
    "pipeline": { "type": "string" },
    "human_approved": { "type": "boolean" },
    "artifacts": {
      "type": "object",
      "description": "Map of canonical artifact name -> path relative to the project dir.",
      "patternProperties": { "^[a-z_]+$": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "artifact_hashes": {
      "type": "object",
      "description": "sha256 of each referenced artifact at checkpoint time (provenance).",
      "patternProperties": { "^[a-z_]+$": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {
        "partial_progress": {
          "type": "object",
          "required": ["completed_unit_ids"],
          "properties": {
            "unit": { "type": "string" },
            "completed_unit_ids": { "type": "array", "items": { "type": "string" } },
            "total_units": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "note": { "type": "string" },
        "qa_rounds": { "type": "integer", "minimum": 0 },
        "cost_snapshot": {
          "type": "object",
          "properties": {
            "stage_cost_usd": { "type": "number", "minimum": 0 },
            "total_spent_usd": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
