{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "full-ai-video-system/artifacts/storyboard_set",
  "title": "Storyboard Set",
  "description": "Produced by stage 8. Three storyboard variants (A/B/C) per scene, each a sequence of generated frames conditioned on locked assets.",
  "type": "object",
  "required": ["version", "project_id", "scenes"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "project_id": { "type": "string", "minLength": 1 },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scene_id", "variants"],
        "properties": {
          "scene_id": { "type": "string", "pattern": "^S\\d{2,}$" },
          "variants": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": ["variant_id", "approach_note", "frames"],
              "properties": {
                "variant_id": { "type": "string", "enum": ["A", "B", "C"] },
                "approach_note": { "type": "string", "minLength": 1, "description": "How this variant differs (framing/energy/coverage) — not a reroll." },
                "frames": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["frame_id", "shot_no", "image_path", "shot_framing", "refs_used", "prompt", "cost_usd"],
                    "properties": {
                      "frame_id": { "type": "string", "pattern": "^S\\d{2,}_[ABC]_F\\d{2,}$" },
                      "shot_no": { "type": "integer", "minimum": 1 },
                      "image_path": { "type": "string", "minLength": 1 },
                      "media_id": { "type": ["string", "null"], "description": "Higgsfield media/job id for passing this frame as start/end/reference (medias[].value)." },
                      "shot_framing": { "type": "string", "minLength": 1 },
                      "camera_hint": { "type": "string" },
                      "is_start_frame_candidate": { "type": "boolean" },
                      "is_end_frame_candidate": { "type": "boolean" },
                      "refs_used": { "type": "array", "items": { "type": "string" }, "description": "asset_manifest element_ids this frame was conditioned on (must be locked)." },
                      "prompt": { "type": "string", "minLength": 1 },
                      "cost_usd": { "type": "number", "minimum": 0 }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false
}
