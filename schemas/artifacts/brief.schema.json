{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "full-ai-video-system/artifacts/brief",
  "title": "Creative Brief",
  "description": "Produced by stage 1 (intake). Conditions every downstream agent.",
  "type": "object",
  "required": ["version", "project_id", "story_idea", "logline", "audience", "duration_target_seconds", "language", "style", "tone", "platform", "aspect_ratio_primary"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "project_id": { "type": "string", "minLength": 1 },
    "story_idea": { "type": "string", "minLength": 1, "description": "The user's idea in their OWN words — verbatim, not paraphrased." },
    "logline": { "type": "string", "minLength": 1, "description": "One-sentence dramatic summary, agreed with the user." },
    "audience": {
      "type": "object",
      "required": ["description"],
      "properties": {
        "description": { "type": "string" },
        "age_range": { "type": "string" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "duration_target_seconds": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "number", "minimum": 30 },
        "max": { "type": "number", "maximum": 600 }
      },
      "additionalProperties": false
    },
    "language": { "type": "string", "minLength": 1, "description": "Language of dialogue and captions, e.g. 'en', 'fa'." },
    "style": { "type": "string", "minLength": 1, "description": "Visual style direction, e.g. 'photoreal cinematic', 'Ghibli-esque 2D'." },
    "tone": { "type": "string", "minLength": 1 },
    "genre": { "type": "string" },
    "platform": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["youtube", "instagram", "tiktok", "linkedin", "cinema", "generic"] } },
    "aspect_ratio_primary": { "type": "string", "enum": ["16:9", "9:16", "1:1"] },
    "content_boundaries": { "type": "array", "items": { "type": "string" }, "description": "What must NOT appear (violence level, scares, brands…)." },
    "music_direction": { "type": "string" },
    "references": { "type": "array", "items": { "type": "string" }, "description": "Films/styles/links the user pointed to." },
    "open_questions": { "type": "array", "items": { "type": "string" }, "description": "Anything the user deferred — never silently resolved." },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false
}
