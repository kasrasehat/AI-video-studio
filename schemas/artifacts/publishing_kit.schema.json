{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "full-ai-video-system/artifacts/publishing_kit",
  "title": "Publishing Kit",
  "description": "Produced by stage 11. Everything needed to post the film: thumbnail concepts with their SAVED generation prompts, title options, description, hashtags/tags, and platform settings. Director-gated like every creative artifact.",
  "type": "object",
  "required": ["version", "project_id", "platform", "thumbnail", "metadata"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "project_id": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "enum": ["youtube", "tiktok", "instagram", "multi"] },
    "thumbnail": {
      "type": "object",
      "required": ["concepts"],
      "properties": {
        "concepts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["concept_id", "strategy", "curiosity_hook", "prompt", "refs_used", "status"],
            "properties": {
              "concept_id": { "type": "string", "pattern": "^TH\\d{2}$" },
              "strategy": { "type": "string", "minLength": 10, "description": "The concept's attention strategy in one sentence (e.g. emotion-close-up, scale-contrast, mid-action freeze)." },
              "curiosity_hook": { "type": "string", "minLength": 10, "description": "What unanswered question this image plants in the viewer's mind." },
              "prompt": { "type": "string", "minLength": 100, "description": "The COMPLETE gpt_image_2 prompt, saved verbatim BEFORE generation. Includes on-image text spec and reference bindings." },
              "on_image_text": { "type": "string", "description": "Exact words rendered inside the image (max ~4 words), empty string if none." },
              "refs_used": { "type": "array", "items": { "type": "string" }, "description": "Locked asset element_ids / media_ids conditioning this concept." },
              "model": { "type": "string" },
              "params": { "type": "object" },
              "media_id": { "type": "string", "description": "Generation job id once generated." },
              "image_path": { "type": "string", "description": "Repo-relative path of the downloaded image." },
              "cost_credits": { "type": "number", "minimum": 0 },
              "status": { "type": "string", "enum": ["proposed", "generated", "approved", "rejected"] },
              "qc_notes": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "selected_concept_id": { "type": "string", "pattern": "^TH\\d{2}$" },
        "delivery_path": { "type": "string", "description": "Final 1280x720 upload-ready file path." }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "required": ["title_options", "description", "hashtags", "tags"],
      "properties": {
        "title_options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["title", "angle"],
            "properties": {
              "title": { "type": "string", "minLength": 5, "maxLength": 100 },
              "angle": { "type": "string", "minLength": 5, "description": "Why this title pulls clicks (curiosity gap, emotion, keyword strategy)." },
              "char_count": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        },
        "selected_title": { "type": "string" },
        "description": {
          "type": "object",
          "required": ["hook_first_125", "full_text"],
          "properties": {
            "hook_first_125": { "type": "string", "maxLength": 125, "description": "The above-the-fold opener shown before 'more' — must sell the click on its own." },
            "full_text": { "type": "string", "minLength": 100 },
            "chapters": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["timecode", "label"],
                "properties": {
                  "timecode": { "type": "string", "pattern": "^\\d{1,2}:\\d{2}$" },
                  "label": { "type": "string", "minLength": 2 }
                },
                "additionalProperties": false
              }
            },
            "cta": { "type": "string", "description": "Subscribe / next-video call to action line." }
          },
          "additionalProperties": false
        },
        "hashtags": { "type": "array", "minItems": 3, "maxItems": 15, "items": { "type": "string", "pattern": "^#\\S+$" }, "description": "YouTube caps at 15; first 3 render above the title." },
        "tags": { "type": "array", "items": { "type": "string" }, "description": "Backend tags, ~500 chars total budget." },
        "category": { "type": "string" },
        "made_for_kids": { "type": "boolean", "description": "COPPA flag decision — Director rules this explicitly." },
        "pinned_comment": { "type": "string" },
        "end_screen_note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
