{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "full-ai-video-system/artifacts/render_report",
  "title": "Render Report",
  "description": "Produced by stage 10 after assembly. Verified outputs + final watch-through QC.",
  "type": "object",
  "required": ["version", "project_id", "outputs", "final_qc", "completed_at"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "project_id": { "type": "string", "minLength": 1 },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["preset_id", "path", "duration_s", "resolution", "fps", "ffprobe_ok"],
        "properties": {
          "preset_id": { "type": "string" },
          "path": { "type": "string" },
          "duration_s": { "type": "number", "exclusiveMinimum": 0 },
          "resolution": { "type": "string" },
          "fps": { "type": "number", "exclusiveMinimum": 0 },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "ffprobe_ok": { "type": "boolean" },
          "lufs_measured": { "type": "number" }
        },
        "additionalProperties": false
      }
    },
    "final_qc": {
      "type": "object",
      "required": ["verdict"],
      "properties": {
        "watch_through_findings": { "type": "array", "items": { "type": "string" } },
        "verdict": { "type": "string", "enum": ["pass", "fix"] }
      },
      "additionalProperties": false
    },
    "total_cost_usd": { "type": "number", "minimum": 0 },
    "completed_at": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false
}
