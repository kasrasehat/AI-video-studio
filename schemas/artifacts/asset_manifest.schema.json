{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "full-ai-video-system/artifacts/asset_manifest",
  "title": "Asset Manifest",
  "description": "Produced by stage 7. Generated reference assets with variants; the Director's pick per element becomes the LOCKED reference all downstream generation must use.",
  "type": "object",
  "required": ["version", "project_id", "elements", "total_cost_usd"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "project_id": { "type": "string", "minLength": 1 },
    "elements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["element_id", "element_type", "source_descriptor_ref", "variants", "locked"],
        "properties": {
          "element_id": { "type": "string", "minLength": 1 },
          "element_type": { "type": "string", "enum": ["character_sheet", "environment_plate", "voice_sample", "object_ref"] },
          "source_descriptor_ref": { "type": "string", "minLength": 1, "description": "char_id / loc_id / object_id in lock_descriptors." },
          "variants": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["variant_id", "files", "generator", "cost_usd"],
              "properties": {
                "variant_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
                "files": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["path"],
                    "properties": {
                      "path": { "type": "string", "minLength": 1 },
                      "view": { "type": "string", "enum": ["front", "three_quarter", "profile", "back", "full_body", "na"] },
                      "media_id": { "type": ["string", "null"], "description": "Higgsfield media/job id for passing this file as a generation reference (medias[].value)." }
                    },
                    "additionalProperties": false
                  }
                },
                "generator": {
                  "type": "object",
                  "required": ["gateway", "model", "prompt"],
                  "properties": {
                    "gateway": { "type": "string" },
                    "model": { "type": "string" },
                    "prompt": { "type": "string" },
                    "seed": { "type": ["integer", "string", "null"] },
                    "params": { "type": "object", "additionalProperties": true }
                  },
                  "additionalProperties": false
                },
                "cost_usd": { "type": "number", "minimum": 0 }
              },
              "additionalProperties": false
            }
          },
          "selected_variant_id": { "type": ["string", "null"], "description": "The Director's pick. Null until the gate." },
          "locked": { "type": "boolean", "description": "True only after the Director picked. Downstream may ONLY reference locked elements." }
        },
        "additionalProperties": false
      }
    },
    "total_cost_usd": { "type": "number", "minimum": 0 },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false
}
